        <mxCell id="movie" value="&lt;div style=&quot;font-weight:bold;text-align:center;padding:9px;font-size:18px&quot;&gt;Movie&lt;/div&gt;&lt;hr style=&quot;margin:0&quot;&gt;&lt;div style=&quot;text-align:left;padding:10px;line-height:1.6&quot;&gt;movieId: String&lt;br&gt;title: String&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F4F8FD;strokeColor=#355C7D;strokeWidth=2;fontSize=15;spacing=0;" vertex="1" parent="1">
