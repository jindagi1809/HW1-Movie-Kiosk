<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="purchase-sequence" name="Purchase Ticket Sequence">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Purchase Ticket — Sequence Diagram" style="text;html=1;align=center;fontSize=25;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="20" width="1040" height="45" />
        </mxCell>
        <mxCell id="participant0" value="Customer" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F4F8FD;strokeColor=#355C7D;strokeWidth=2;fontSize=19;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="90" width="200" height="55" />
        </mxCell>
        <mxCell id="lifeline0" value="" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="120" y="145" />
            <mxPoint as="targetPoint" x="120" y="890" />
          </mxGeometry>
        </mxCell>
        <mxCell id="participant1" value="Kiosk Interface" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F4F8FD;strokeColor=#355C7D;strokeWidth=2;fontSize=19;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="320" y="90" width="200" height="55" />
        </mxCell>
        <mxCell id="lifeline1" value="" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="420" y="145" />
            <mxPoint as="targetPoint" x="420" y="890" />
          </mxGeometry>
        </mxCell>
        <mxCell id="participant2" value="Ticket Service" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F4F8FD;strokeColor=#355C7D;strokeWidth=2;fontSize=19;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="90" width="200" height="55" />
        </mxCell>
        <mxCell id="lifeline2" value="" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="720" y="145" />
            <mxPoint as="targetPoint" x="720" y="890" />
          </mxGeometry>
        </mxCell>
        <mxCell id="participant3" value="Payment Service" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F4F8FD;strokeColor=#355C7D;strokeWidth=2;fontSize=19;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="90" width="200" height="55" />
        </mxCell>
        <mxCell id="lifeline3" value="" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1040" y="145" />
            <mxPoint as="targetPoint" x="1040" y="890" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1" value="1. Select showtime" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="120" y="190" />
            <mxPoint as="targetPoint" x="420" y="190" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2. Request available seats" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="420" y="245" />
            <mxPoint as="targetPoint" x="720" y="245" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3. Return available seats" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="720" y="300" />
            <mxPoint as="targetPoint" x="420" y="300" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4. Display available seats" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="420" y="355" />
            <mxPoint as="targetPoint" x="120" y="355" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5. Select seat and provide payment" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="120" y="410" />
            <mxPoint as="targetPoint" x="420" y="410" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6. Request ticket purchase" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="420" y="465" />
            <mxPoint as="targetPoint" x="720" y="465" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7. Check availability and hold seat" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="720" y="520" />
            <mxPoint as="targetPoint" x="720" y="565" />
            <Array as="points">
              <mxPoint x="990" y="520" />
              <mxPoint x="990" y="565" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="8. Process payment" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="720" y="620" />
            <mxPoint as="targetPoint" x="1040" y="620" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="9. Payment approved" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1040" y="675" />
            <mxPoint as="targetPoint" x="720" y="675" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="10. Mark seat sold and create ticket" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="720" y="725" />
            <mxPoint as="targetPoint" x="720" y="770" />
            <Array as="points">
              <mxPoint x="990" y="725" />
              <mxPoint x="990" y="770" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m11" value="11. Return ticket confirmation" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="720" y="820" />
            <mxPoint as="targetPoint" x="420" y="820" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="12. Display confirmation" style="html=1;rounded=0;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="420" y="870" />
            <mxPoint as="targetPoint" x="120" y="870" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="Successful purchase scenario. The availability check and seat hold are atomic for the selected showtime and seat, preventing simultaneous purchases. Failure paths are omitted." style="shape=note;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fillColor=#FFF7DF;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="920" width="1000" height="55" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>